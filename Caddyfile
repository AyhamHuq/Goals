# Host-level Caddy reverse proxy (runs on the Hetzner server, not in Docker).
# Both A records must point to the server IP before first deploy.
#
# Prerequisites for HTTPS:
# 1. Create a free subdomain at https://www.duckdns.org
# 2. Point the DuckDNS A record to your Hetzner server IP
# 3. Replace your-subdomain.duckdns.org with your actual subdomain below

goaltracking.duckdns.org {
    reverse_proxy localhost:3100
}

staging.goaltracking.duckdns.org {
    reverse_proxy localhost:3101
}
