DATABASE_URL=postgres://goals:goals@localhost:5432/goals
PORT=3001
NODE_ENV=development
DB_PASSWORD=goals

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:your@email.com

# Admin dashboard PIN (required for admin-goals.ayhamhuq.com)
ADMIN_PIN=change_me

# HTTPS: goals.ayhamhuq.com and admin-goals.ayhamhuq.com are routed by Caddy on the shared Docker web network.
